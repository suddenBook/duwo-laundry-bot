# ---- required ----
DUWO_EMAIL=your_email@example.com
DUWO_PASSWORD=your_password
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ---- polling ----
# How often the bot checks DUWO, in seconds.
CHECK_INTERVAL=120

# ---- own-machine cycle tracking ----
# DUWO releases a machine on a fixed timer measured from the terminal start
# (washer 35 min, dryer 40 min), which expires well before the door actually
# opens. These are the REAL durations; /done refines them over time.
WASHER_CYCLE_MINUTES=55
DRYER_CYCLE_MINUTES=44
# Minutes of warning before a machine is ready, so you can walk down.
CYCLE_HEADSUP_MINUTES=5
# How far back in the DUWO log to look for machine starts.
CYCLE_LOOKBACK_HOURS=6

# ---- unsolicited alerts (off by default) ----
# Turn these on only if you want the bot to message you unprompted.
NOTIFY_AVAILABILITY=false
NOTIFY_LOW_BALANCE=false
LOW_BALANCE_THRESHOLD=3.0
WASHER_NOTIFY_THRESHOLD=3
DRYER_NOTIFY_THRESHOLD=1
